<UserControl
    x:Class="OnlyM.Dialogs.ConfirmDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:system="clr-namespace:System;assembly=System.Runtime"
    MinWidth="320"
    MaxWidth="440"
    Background="{DynamicResource MaterialDesignPaper}"
    FontFamily="{DynamicResource MaterialDesignFont}"
    TextElement.FontSize="13"
    TextElement.FontWeight="Regular"
    TextElement.Foreground="{DynamicResource MaterialDesignBody}"
    TextOptions.TextFormattingMode="Ideal"
    TextOptions.TextRenderingMode="Auto">

    <!--  Simple yes/no confirmation. DialogHost.Show returns the CommandParameter of the button pressed (true/false)  -->
    <StackPanel Margin="24,20,24,20" Orientation="Vertical">
        <TextBlock
            x:Name="MessageTextBlock"
            FontSize="16"
            FontWeight="SemiBold"
            TextWrapping="Wrap" />

        <TextBlock
            x:Name="DetailTextBlock"
            Margin="0,8,0,0"
            Opacity="0.72"
            TextWrapping="Wrap"
            Visibility="Collapsed" />

        <StackPanel
            Margin="0,24,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <!--  Primary action: the one filled button  -->
            <Button
                x:Name="ConfirmButton"
                Style="{StaticResource OnlyMDialogPrimaryButton}"
                Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}">
                <Button.CommandParameter>
                    <system:Boolean>True</system:Boolean>
                </Button.CommandParameter>
            </Button>

            <Button
                x:Name="CancelButton"
                Margin="8,0,0,0"
                Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"
                IsCancel="True"
                IsDefault="True"
                Style="{StaticResource OnlyMDialogSecondaryButton}">
                <Button.CommandParameter>
                    <system:Boolean>False</system:Boolean>
                </Button.CommandParameter>
            </Button>
        </StackPanel>
    </StackPanel>
</UserControl>
