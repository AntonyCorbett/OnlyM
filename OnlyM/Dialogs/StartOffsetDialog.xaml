<UserControl
    x:Class="OnlyM.Dialogs.StartOffsetDialog"
    x:Name="OnlyMStartOffsetDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resx="clr-namespace:OnlyM.Properties"
    Width="340"
    d:DesignHeight="420"
    Background="{DynamicResource MaterialDesignPaper}"
    DataContext="{Binding Source={StaticResource Locator}, Path=StartOffsetDialog}"
    FontFamily="{DynamicResource MaterialDesignFont}"
    TextElement.FontSize="13"
    TextElement.FontWeight="Regular"
    TextElement.Foreground="{DynamicResource MaterialDesignBody}"
    TextOptions.TextFormattingMode="Ideal"
    TextOptions.TextRenderingMode="Auto"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!--  Column captions above the hour / minute / second lists  -->
        <Style x:Key="ColumnCaptionStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Margin" Value="2,0,0,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.72" />
        </Style>

        <!--  Rounded hairline frame around each list  -->
        <Style x:Key="ListFrameStyle" TargetType="{x:Type Border}">
            <Setter Property="Height" Value="200" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesignDivider}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>

        <Style
            x:Key="ListStyle"
            BasedOn="{StaticResource MaterialDesignListBox}"
            TargetType="{x:Type ListBox}">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.PanningMode" Value="VerticalOnly" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <!--  Compact rows; the selected value is the one purple element in each list  -->
                    <Style TargetType="{x:Type ListBoxItem}">
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Margin" Value="0,1" />
                        <Setter Property="Padding" Value="10,4" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                    <Border
                                        Padding="{TemplateBinding Padding}"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="4">
                                        <ContentPresenter />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource MaterialDesignDivider}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource PrimaryHueMidBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryHueMidForegroundBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel Margin="24,20,24,20" Orientation="Vertical">
        <TextBlock
            FontSize="16"
            FontWeight="SemiBold"
            Text="{x:Static resx:Resources.SET_MEDIA_START}"
            TextWrapping="Wrap" />

        <Grid Margin="0,8,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  Green when the time is valid, red when it is beyond the end of the media  -->
            <TextBlock
                Grid.Column="0"
                VerticalAlignment="Bottom"
                FontSize="24"
                FontWeight="SemiBold"
                Foreground="{Binding ChosenTimeBrush}"
                Text="{Binding ChosenTimeAsString}" />

            <ComboBox
                Grid.Column="1"
                VerticalAlignment="Bottom"
                materialDesign:HintAssist.Hint="{x:Static resx:Resources.RECENT_TIMES}"
                ItemsSource="{Binding RecentTimes}"
                SelectedItem="{Binding ChosenRecentTime}"
                SelectedValuePath="Seconds"
                Style="{StaticResource MaterialDesignComboBox}"
                Visibility="{Binding Path=HasRecentTimes, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel>
                            <TextBlock
                                VerticalAlignment="Center"
                                DockPanel.Dock="Left"
                                Text="{Binding AsString}" />
                            <Button
                                Width="22"
                                Height="22"
                                Margin="8,0,0,0"
                                HorizontalAlignment="Right"
                                Command="{Binding Path=DataContext.RemoveRecentTimeCommand, ElementName=OnlyMStartOffsetDialog}"
                                CommandParameter="{Binding Seconds}"
                                DockPanel.Dock="Right"
                                Foreground="{DynamicResource MaterialDesignBodyLight}"
                                Style="{StaticResource MaterialDesignIconForegroundButton}"
                                Visibility="{Binding Path=IsNotZero, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <materialDesign:PackIcon
                                    Width="16"
                                    Height="16"
                                    Kind="TrashCanOutline" />
                            </Button>
                        </DockPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock
                Grid.Row="0"
                Grid.Column="0"
                Style="{StaticResource ColumnCaptionStyle}"
                Text="{x:Static resx:Resources.HOURS}" />
            <TextBlock
                Grid.Row="0"
                Grid.Column="2"
                Style="{StaticResource ColumnCaptionStyle}"
                Text="{x:Static resx:Resources.MINUTES}" />
            <TextBlock
                Grid.Row="0"
                Grid.Column="4"
                Style="{StaticResource ColumnCaptionStyle}"
                Text="{x:Static resx:Resources.SECONDS}" />

            <Border
                Grid.Row="1"
                Grid.Column="0"
                Style="{StaticResource ListFrameStyle}">
                <ListBox
                    ItemsSource="{Binding Hours}"
                    SelectedIndex="{Binding ChosenHours}"
                    Style="{StaticResource ListStyle}" />
            </Border>

            <Border
                Grid.Row="1"
                Grid.Column="2"
                Style="{StaticResource ListFrameStyle}">
                <ListBox
                    ItemsSource="{Binding Minutes}"
                    SelectedIndex="{Binding ChosenMinutes}"
                    Style="{StaticResource ListStyle}" />
            </Border>

            <Border
                Grid.Row="1"
                Grid.Column="4"
                Style="{StaticResource ListFrameStyle}">
                <ListBox
                    ItemsSource="{Binding Seconds}"
                    SelectedIndex="{Binding ChosenSeconds}"
                    Style="{StaticResource ListStyle}" />
            </Border>
        </Grid>

        <StackPanel
            Margin="0,24,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Command="{Binding OkCommand}"
                Content="{x:Static resx:Resources.DLG_OK}"
                IsDefault="True"
                IsEnabled="{Binding IsTimeValid}"
                Style="{StaticResource OnlyMDialogPrimaryButton}" />

            <Button
                Margin="8,0,0,0"
                Command="{Binding CancelCommand}"
                Content="{x:Static resx:Resources.DLG_CANCEL}"
                IsCancel="True"
                Style="{StaticResource OnlyMDialogSecondaryButton}" />
        </StackPanel>
    </StackPanel>
</UserControl>
