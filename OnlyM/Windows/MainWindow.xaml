<Window
    x:Class="OnlyM.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resx="clr-namespace:OnlyM.Properties"
    Title="OnlyM"
    Width="500"
    Height="650"
    MinWidth="366"
    MinHeight="370"
    Background="{DynamicResource MaterialDesignPaper}"
    Closing="WindowClosing"
    DataContext="{Binding Main, Mode=OneWay, Source={StaticResource Locator}}"
    FontFamily="{DynamicResource MaterialDesignFont}"
    Icon="/OnlyM;component/icon3.ico"
    ResizeMode="NoResize"
    TextElement.FontSize="13"
    TextElement.FontWeight="Regular"
    TextElement.Foreground="{DynamicResource MaterialDesignBody}"
    TextOptions.TextFormattingMode="Ideal"
    TextOptions.TextRenderingMode="Auto"
    Topmost="{Binding AlwaysOnTop, Mode=OneWay}"
    mc:Ignorable="d">

    <Window.Resources>
        <ResourceDictionary>

            <!--  Scrollbar Thumbs  -->
            <Style x:Key="ScrollThumbs" TargetType="{x:Type Thumb}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Thumb}">
                            <Grid x:Name="Grid">
                                <Rectangle
                                    Width="Auto"
                                    Height="Auto"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    Fill="Transparent" />
                                <Border
                                    x:Name="Rectangle1"
                                    Width="Auto"
                                    Height="Auto"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="8" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!--  ScrollBars  -->
            <Style TargetType="{x:Type ScrollBar}">
                <Setter Property="Stylus.IsFlicksEnabled" Value="false" />
                <Setter Property="Foreground" Value="#FFE8E3F3" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Width" Value="18" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ScrollBar}">
                            <Grid
                                x:Name="GridRoot"
                                Width="18"
                                Background="{TemplateBinding Background}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="0.00001*" />
                                </Grid.RowDefinitions>
                                <Track
                                    x:Name="PART_Track"
                                    Grid.Row="0"
                                    Focusable="false"
                                    IsDirectionReversed="true">
                                    <Track.Thumb>
                                        <Thumb
                                            x:Name="Thumb"
                                            Background="{TemplateBinding Foreground}"
                                            Style="{DynamicResource ScrollThumbs}" />
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton
                                            x:Name="PageUp"
                                            Height="Auto"
                                            Command="ScrollBar.PageDownCommand"
                                            Focusable="false"
                                            Opacity="0" />
                                    </Track.IncreaseRepeatButton>
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton
                                            x:Name="PageDown"
                                            Height="Auto"
                                            Command="ScrollBar.PageUpCommand"
                                            Focusable="false"
                                            Opacity="0" />
                                    </Track.DecreaseRepeatButton>
                                </Track>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger SourceName="Thumb" Property="IsMouseOver" Value="true">
                                    <Setter TargetName="Thumb" Property="Background" Value="{DynamicResource PrimaryHueLightBrush}" />
                                </Trigger>
                                <Trigger SourceName="Thumb" Property="IsDragging" Value="true">
                                    <Setter TargetName="Thumb" Property="Background" Value="{DynamicResource PrimaryHueMidBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="false">
                                    <Setter TargetName="Thumb" Property="Visibility" Value="Collapsed" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--  Volume control (operator page toolbar): an icon button opening a popup with mute button, slider and level label.  -->
            <!--  OnlyMNavBarForeground is near-white on the dark-mode toolbar and deep purple on the light-mode toolbar (see DarkModeService)  -->
            <Style
                x:Key="OnlyMVolumeButton"
                BasedOn="{StaticResource MaterialDesignIconButton}"
                TargetType="{x:Type Button}">
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="40" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Foreground" Value="{DynamicResource OnlyMNavBarForeground}" />
            </Style>

            <!--  Foreground set here rather than inherited: the PopupBox's internal toggle button does not pass its Foreground through  -->
            <Style x:Key="OnlyMVolumeIcon" TargetType="{x:Type materialDesign:PackIcon}">
                <Setter Property="Foreground" Value="{DynamicResource OnlyMNavBarForeground}" />
                <Setter Property="Width" Value="30" />
                <Setter Property="Height" Value="30" />
                <Style.Triggers>
                    <!--  Muted: dimmed VolumeOff icon (the tooltip says "Muted")  -->
                    <DataTrigger Binding="{Binding IsMuted}" Value="True">
                        <Setter Property="Opacity" Value="0.55" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="OnlyMVolumeLabel" TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="{DynamicResource OnlyMNavBarForeground}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <Style x:Key="OnlyMVolumeSliderTrack" TargetType="{x:Type RepeatButton}">
                <Setter Property="OverridesDefaultStyle" Value="True" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type RepeatButton}">
                            <!--  Transparent hit area keeps the track easy to click  -->
                            <Border Background="Transparent">
                                <Border
                                    Height="4"
                                    VerticalAlignment="Center"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="2" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="OnlyMVolumeSliderThumb" TargetType="{x:Type Thumb}">
                <Setter Property="OverridesDefaultStyle" Value="True" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Thumb}">
                            <Grid
                                Width="18"
                                Height="18"
                                Background="Transparent">
                                <Ellipse
                                    x:Name="Dot"
                                    Width="15"
                                    Height="15"
                                    Fill="{DynamicResource OnlyMNavBarForeground}" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Dot" Property="Width" Value="17" />
                                    <Setter TargetName="Dot" Property="Height" Value="17" />
                                </Trigger>
                                <Trigger Property="IsDragging" Value="True">
                                    <Setter TargetName="Dot" Property="Width" Value="17" />
                                    <Setter TargetName="Dot" Property="Height" Value="17" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="OnlyMVolumeSlider" TargetType="{x:Type Slider}">
                <Setter Property="OverridesDefaultStyle" Value="True" />
                <Setter Property="MinWidth" Value="48" />
                <Setter Property="Height" Value="24" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Minimum" Value="0" />
                <Setter Property="Maximum" Value="100" />
                <Setter Property="SmallChange" Value="5" />
                <Setter Property="LargeChange" Value="10" />
                <Setter Property="IsMoveToPointEnabled" Value="True" />
                <Setter Property="AutoToolTipPlacement" Value="TopLeft" />
                <Setter Property="AutoToolTipPrecision" Value="0" />
                <Setter Property="Focusable" Value="True" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Slider}">
                            <Grid Background="Transparent">
                                <!--  Keyboard focus indicator (replaces the default dashed focus rectangle)  -->
                                <Border
                                    x:Name="FocusRing"
                                    Margin="-4,0"
                                    BorderBrush="{DynamicResource OnlyMNavBarForeground}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Opacity="0" />
                                <Track x:Name="PART_Track">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton
                                            Background="{DynamicResource OnlyMNavBarForeground}"
                                            Command="{x:Static Slider.DecreaseLarge}"
                                            Style="{StaticResource OnlyMVolumeSliderTrack}" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <!--  Unfilled part: same colour at about a third opacity so the full range stays visible  -->
                                        <RepeatButton
                                            Background="{DynamicResource OnlyMNavBarForeground}"
                                            Command="{x:Static Slider.IncreaseLarge}"
                                            Opacity="0.33"
                                            Style="{StaticResource OnlyMVolumeSliderTrack}" />
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource OnlyMVolumeSliderThumb}" />
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </Window.Resources>

    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Paste" Executed="OnPaste" />
    </Window.CommandBindings>

    <materialDesign:DialogHost>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="74" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <ContentControl Content="{Binding CurrentPage}" />
                <TextBlock
                    Height="20"
                    Margin="20,20,20,0"
                    VerticalAlignment="Top"
                    Text="{x:Static resx:Resources.DROP_HERE}"
                    Visibility="{Binding Path=ShowDragAndDropHint, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <materialDesign:Snackbar MessageQueue="{Binding TheSnackbarMessageQueue}" />

                <Rectangle Height="4" VerticalAlignment="Top">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                            <GradientStop Offset="0" Color="#72000000" />
                            <GradientStop Offset="1" Color="#00000000" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <Rectangle Height="4" VerticalAlignment="Bottom">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                            <GradientStop Offset="0" Color="#00000000" />
                            <GradientStop Offset="1" Color="#72000000" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
            </Grid>

            <Border Grid.Row="1" Background="{DynamicResource OnlyMNavBarBackground}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <ProgressBar
                        Grid.Row="0"
                        Height="3"
                        IsIndeterminate="True"
                        Visibility="{Binding Path=ShowProgressBar, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <ContentControl Grid.Row="1" Padding="10" VerticalAlignment="Stretch">
                    <Grid Margin="10,0,10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="50" />
                            <ColumnDefinition Width="50" />
                            <ColumnDefinition Width="50" />
                            <ColumnDefinition Width="50" />
                        </Grid.ColumnDefinitions>

                        <Button
                            Grid.Column="0"
                            HorizontalAlignment="Left"
                            Command="{Binding GotoOperatorCommand}"
                            Style="{StaticResource MaterialDesignFloatingActionMiniDarkButton}"
                            ToolTip="{x:Static resx:Resources.MEDIA_PAGE}"
                            Visibility="{Binding Path=IsSettingsPageActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <materialDesign:PackIcon
                                Width="24"
                                Height="24"
                                Kind="Backburger" />
                        </Button>

                        <StackPanel
                            Grid.Column="0"
                            HorizontalAlignment="Left"
                            Orientation="Horizontal">

                            <!--  Volume for video and audio (also adjustable from the HTTP remote): one icon button that opens a popup  -->
                            <!--  with mute, slider and level. Operator page only, and only when 'Show volume control' is on (Settings)  -->
                            <!--  Sits on the left, apart from the round FAB buttons, since it is a different form  -->
                            <Grid
                                Margin="0,0,16,0"
                                VerticalAlignment="Center"
                                Visibility="{Binding Path=IsOperatorPageActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <materialDesign:PopupBox
                                    Padding="0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    AutomationProperties.HelpText="{Binding VolumeToolTip}"
                                    AutomationProperties.Name="{x:Static resx:Resources.VOLUME}"
                                    DataContext="{Binding Operator, Source={StaticResource Locator}}"
                                    Foreground="{DynamicResource OnlyMNavBarForeground}"
                                    PlacementMode="TopAndAlignLeftEdges"
                                    StaysOpen="True"
                                    ToolTip="{Binding VolumeToolTip}"
                                    Visibility="{Binding Path=ShowVolumeControl, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <materialDesign:PopupBox.ToggleContent>
                                        <materialDesign:PackIcon Kind="{Binding VolumeIconKind}" Style="{StaticResource OnlyMVolumeIcon}" />
                                    </materialDesign:PopupBox.ToggleContent>

                                    <Border Padding="8,4" Background="{DynamicResource OnlyMNavBarBackground}">
                                        <StackPanel Orientation="Horizontal">
                                            <Button
                                                AutomationProperties.HelpText="{Binding VolumeToolTip}"
                                                AutomationProperties.Name="{Binding MuteButtonName}"
                                                Command="{Binding ToggleMuteCommand}"
                                                Style="{StaticResource OnlyMVolumeButton}"
                                                ToolTip="{Binding MuteButtonToolTip}">
                                                <materialDesign:PackIcon Kind="{Binding VolumeIconKind}" Style="{StaticResource OnlyMVolumeIcon}" />
                                            </Button>

                                            <Slider
                                                Width="150"
                                                Margin="4,0,0,0"
                                                AutomationProperties.HelpText="{Binding VolumeToolTip}"
                                                AutomationProperties.Name="{x:Static resx:Resources.VOLUME}"
                                                Style="{StaticResource OnlyMVolumeSlider}"
                                                ToolTip="{Binding VolumeToolTip}"
                                                Value="{Binding Volume, Mode=TwoWay}" />

                                            <!--  Fixed width so the slider does not move: '65%', '0%' when muted (the tooltip says 'Muted')  -->
                                            <TextBlock
                                                Width="38"
                                                Margin="6,0,0,0"
                                                AutomationProperties.Name="{Binding VolumeToolTip}"
                                                Style="{StaticResource OnlyMVolumeLabel}"
                                                Text="{Binding VolumeLabel}"
                                                ToolTip="{Binding VolumeToolTip}" />
                                        </StackPanel>
                                    </Border>
                                </materialDesign:PopupBox>
                            </Grid>

                            <Button
                                Command="{Binding UnhideCommand}"
                                Content="{x:Static resx:Resources.UNHIDE}"
                                Style="{StaticResource MaterialDesignRaisedAccentButton}"
                                Visibility="{Binding Path=IsUnhideButtonVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>

                        <Button
                            Grid.Column="1"
                            Command="{Binding LaunchReleasePageCommand}"
                            Style="{StaticResource MaterialDesignFloatingActionMiniAccentButton}"
                            ToolTip="{x:Static resx:Resources.NEW_VERSION}"
                            Visibility="{Binding Path=ShowNewVersionButton, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <materialDesign:PackIcon
                                Width="24"
                                Height="24"
                                Kind="Download" />
                        </Button>

                        <Button
                            Grid.Column="2"
                            Command="{Binding LaunchMediaFolderCommand}"
                            IsEnabled="{Binding Path=IsFolderEnabled}"
                            Style="{StaticResource MaterialDesignFloatingActionMiniDarkButton}"
                            ToolTip="{Binding FolderHint}"
                            ToolTipService.ShowOnDisabled="True"
                            Visibility="{Binding Path=IsOperatorPageActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <materialDesign:PackIcon
                                Width="24"
                                Height="24"
                                Kind="FolderOpen" />
                        </Button>

                        <Button
                            Grid.Column="3"
                            Command="{Binding LaunchHelpPageCommand}"
                            Style="{StaticResource MaterialDesignFloatingActionMiniDarkButton}"
                            ToolTip="{x:Static resx:Resources.DISPLAY_HELP}"
                            Visibility="{Binding Path=IsOperatorPageActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <materialDesign:PackIcon
                                Width="24"
                                Height="24"
                                Kind="Help" />
                        </Button>

                        <Button
                            Grid.Column="4"
                            Command="{Binding GotoSettingsCommand}"
                            IsEnabled="{Binding Path=IsSettingsEnabled}"
                            Style="{StaticResource MaterialDesignFloatingActionMiniDarkButton}"
                            ToolTip="{Binding SettingsHint}"
                            ToolTipService.ShowOnDisabled="True"
                            Visibility="{Binding Path=IsOperatorPageActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <materialDesign:PackIcon
                                Width="24"
                                Height="24"
                                Kind="Settings" />
                        </Button>
                    </Grid>

                    </ContentControl>
                </Grid>
            </Border>

        </Grid>
        <materialDesign:DialogHost.DialogContent>
            <StackPanel Margin="16" />
        </materialDesign:DialogHost.DialogContent>
    </materialDesign:DialogHost>

</Window>



