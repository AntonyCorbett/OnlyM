<UserControl
    x:Class="OnlyM.Windows.OperatorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:OnlyM.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:OnlyM.Models"
    xmlns:resx="clr-namespace:OnlyM.Properties"
    x:Name="OnlyMOperatorPage"
    d:DesignHeight="450"
    d:DesignWidth="600"
    AllowDrop="True"
    Background="{DynamicResource MaterialDesignPaper}"
    DataContext="{Binding Operator, Mode=OneWay, Source={StaticResource Locator}}"
    FontFamily="{DynamicResource MaterialDesignFont}"
    Loaded="OnLoaded"
    SizeChanged="OnlyMOperatorPage_SizeChanged"
    TextElement.FontSize="18"
    TextElement.FontWeight="Regular"
    TextElement.Foreground="{DynamicResource MaterialDesignBody}"
    TextOptions.TextFormattingMode="Ideal"
    TextOptions.TextRenderingMode="Auto"
    Unloaded="OnUnloaded"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Button.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.PopupBox.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.TextBlock.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.ToggleButton.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--  Secondary card actions (pause, slide navigation, command panel): quiet outlined buttons so Play/Stop stay the focal point  -->
            <Style
                x:Key="OnlyMSubtleButton"
                BasedOn="{StaticResource MaterialDesignOutlinedButton}"
                TargetType="{x:Type Button}">
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="8,0" />
                <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
                <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesignDivider}" />
                <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="4" />
            </Style>

            <!--  Command panel (Delete / Hide): compact buttons that fit two rows inside the card  -->
            <Style
                x:Key="OnlyMPanelAccentButton"
                BasedOn="{StaticResource MaterialDesignRaisedAccentButton}"
                TargetType="{x:Type Button}">
                <Setter Property="Height" Value="28" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="4" />
                <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp0" />
            </Style>

            <Style
                x:Key="OnlyMPanelSubtleButton"
                BasedOn="{StaticResource OnlyMSubtleButton}"
                TargetType="{x:Type Button}">
                <Setter Property="Height" Value="28" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style
                x:Key="SlideshowButtonStyle"
                BasedOn="{StaticResource OnlyMSubtleButton}"
                TargetType="{x:Type Button}">
                <Setter Property="Width" Value="56" />
                <Setter Property="Height" Value="Auto" />
                <Setter Property="Padding" Value="0" />
            </Style>

            <!--  Play / Stop: compact, flat round buttons (purple = ready to play, accent = playing)  -->
            <Style
                x:Key="OnlyMPlayButton"
                BasedOn="{StaticResource MaterialDesignFloatingActionMiniButton}"
                TargetType="{x:Type Button}">
                <Setter Property="Width" Value="38" />
                <Setter Property="Height" Value="38" />
                <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp0" />
            </Style>

            <Style
                x:Key="OnlyMStopButton"
                BasedOn="{StaticResource MaterialDesignFloatingActionMiniAccentButton}"
                TargetType="{x:Type Button}">
                <Setter Property="Width" Value="38" />
                <Setter Property="Height" Value="38" />
                <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp0" />
            </Style>

            <!--  Thin rounded strip that opens / closes a card's command panel  -->
            <Style x:Key="OnlyMDrawerTabButton" TargetType="{x:Type Button}">
                <Setter Property="Width" Value="10" />
                <Setter Property="Margin" Value="0,0,2,0" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="Background" Value="{DynamicResource MaterialDesignDivider}" />
                <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border
                                x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource PrimaryHueLightBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource PrimaryHueMidBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.35" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="OnlyMDrawerTabIcon" TargetType="{x:Type materialDesign:PackIcon}">
                <Setter Property="Width" Value="12" />
                <Setter Property="Height" Value="12" />
            </Style>

            <!--  Duration / playback time: colour comes from the item (active vs idle)  -->
            <Style x:Key="OnlyMTimeText" TargetType="{x:Type TextBlock}">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <DataTemplate DataType="{x:Type models:MediaItem}">
                <!--  Media Item Card: flat, hairline border; the border turns purple while the item is playing  -->
                <materialDesign:Card
                    x:Name="TheCard"
                    Height="108"
                    Margin="4,3"
                    Padding="0"
                    materialDesign:ElevationAssist.Elevation="Dp0"
                    Background="{DynamicResource MaterialDesignCardBackground}"
                    UniformCornerRadius="6"
                    Visibility="{Binding Path=IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">

                    <materialDesign:Card.Style>
                        <Style TargetType="materialDesign:Card">
                            <Setter Property="Opacity" Value="1" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBeingDragged}" Value="True">
                                    <Setter Property="Opacity" Value="0.45" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </materialDesign:Card.Style>

                    <Border CornerRadius="6">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesignDivider}" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="Padding" Value="5" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMediaActive}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryHueMidBrush}" />
                                        <Setter Property="BorderThickness" Value="2" />
                                        <Setter Property="Padding" Value="4" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsBeingDragged}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource ValidationErrorBrush}" />
                                        <Setter Property="BorderThickness" Value="2" />
                                        <Setter Property="Padding" Value="4" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <!--  Flat panel in the card colour (the default drawer shadow spilled into the card padding as a dark line);  -->
                        <!--  the overlay also uses the card colour so the card fades back instead of going near-black  -->
                        <materialDesign:DrawerHost
                            materialDesign:ElevationAssist.Elevation="Dp0"
                            IsLeftDrawerOpen="{Binding IsCommandPanelOpen, Mode=TwoWay}"
                            LeftDrawerBackground="{DynamicResource MaterialDesignCardBackground}"
                            OverlayBackground="{DynamicResource MaterialDesignCardBackground}"
                            UseLayoutRounding="True">

                            <!--  Command Panel  -->
                            <materialDesign:DrawerHost.LeftDrawerContent>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                    </Grid.ColumnDefinitions>

                                    <!--  Command Panel controls  -->
                                    <Grid
                                        Grid.Column="0"
                                        Margin="10,4,16,4"
                                        TextElement.FontSize="13">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" MinWidth="80" />
                                            <ColumnDefinition Width="*" MaxWidth="220" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="1*" />
                                            <RowDefinition Height="1*" />
                                        </Grid.RowDefinitions>

                                        <Button
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Command="{Binding Path=DataContext.DeleteMediaItemCommand, ElementName=OnlyMOperatorPage}"
                                            CommandParameter="{Binding Id}"
                                            Content="{x:Static resx:Resources.DELETE}"
                                            Style="{StaticResource OnlyMPanelAccentButton}" />

                                        <Button
                                            Grid.Row="1"
                                            Grid.Column="0"
                                            Command="{Binding Path=DataContext.HideMediaItemCommand, ElementName=OnlyMOperatorPage}"
                                            CommandParameter="{Binding Id}"
                                            Content="{x:Static resx:Resources.HIDE}"
                                            Style="{StaticResource OnlyMPanelSubtleButton}" />

                                        <CheckBox
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Margin="12,0,0,0"
                                            VerticalAlignment="Center"
                                            Command="{Binding Path=DataContext.FreezeVideoCommand, ElementName=OnlyMOperatorPage}"
                                            CommandParameter="{Binding Id}"
                                            Content="{x:Static resx:Resources.FREEZE}"
                                            IsChecked="{Binding PauseOnLastFrame, Mode=TwoWay}"
                                            ToolTip="{x:Static resx:Resources.PAUSE_FINAL_FRAME}"
                                            Visibility="{Binding ShouldDisplayFreezeCommand, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                        <ComboBox
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Margin="12,0,0,0"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Center"
                                            materialDesign:HintAssist.Hint="{x:Static resx:Resources.PDF_VIEW}"
                                            ItemsSource="{Binding PdfViewStyles}"
                                            SelectedValue="{Binding ChosenPdfViewStyle}"
                                            SelectedValuePath="Style"
                                            Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                                            Visibility="{Binding ShouldDisplayPdfViewCombo, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                        <TextBox
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Margin="12,0,0,0"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Center"
                                            materialDesign:HintAssist.Hint="{x:Static resx:Resources.PDF_PAGENUM}"
                                            Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                            Text="{Binding ChosenPdfPage}"
                                            Visibility="{Binding ShouldDisplayPdfPageTextBox, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                    </Grid>

                                    <!--  'Left' arrow button to close Command Panel  -->
                                    <Button
                                        Grid.Column="1"
                                        Command="{Binding Path=DataContext.CloseCommandPanelCommand, ElementName=OnlyMOperatorPage}"
                                        CommandParameter="{Binding Id}"
                                        Style="{StaticResource OnlyMDrawerTabButton}">

                                        <materialDesign:PackIcon Kind="ChevronLeft" Style="{StaticResource OnlyMDrawerTabIcon}" />
                                    </Button>

                                    <!--  Soft shadow just beyond the panel's right edge (right edge only: a full drawer shadow shows as a line under the panel)  -->
                                    <Rectangle
                                        Grid.Column="1"
                                        Width="6"
                                        Margin="0,0,-6,0"
                                        HorizontalAlignment="Right"
                                        IsHitTestVisible="False">
                                        <Rectangle.Fill>
                                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                                <GradientStop Offset="0" Color="#30000000" />
                                                <GradientStop Offset="1" Color="#00000000" />
                                            </LinearGradientBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>

                                </Grid>
                            </materialDesign:DrawerHost.LeftDrawerContent>
                            <!--  End of Command Panel  -->

                            <!--  Media Card Body  -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{Binding CommandPanelBtnColWidth}" />
                                    <ColumnDefinition Width="{Binding Path=DataContext.ThumbnailColWidth, ElementName=OnlyMOperatorPage}" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="60" />
                                </Grid.ColumnDefinitions>

                                <!--  'Right' arrow button to open Command Panel  -->
                                <Button
                                    Grid.Column="0"
                                    Command="{Binding Path=DataContext.OpenCommandPanelCommand, ElementName=OnlyMOperatorPage}"
                                    CommandParameter="{Binding Id}"
                                    IsEnabled="{Binding CommandPanelEnabled}"
                                    Style="{StaticResource OnlyMDrawerTabButton}">

                                    <materialDesign:PackIcon Kind="ChevronRight" Style="{StaticResource OnlyMDrawerTabIcon}" />
                                </Button>

                                <!--  Thumbnail  -->
                                <Border Grid.Column="1" Background="Black">
                                    <Grid>
                                        <Image Source="{Binding ThumbnailImageSource}">
                                            <Image.ToolTip>
                                                <ToolTip
                                                    HorizontalOffset="54"
                                                    Placement="Center"
                                                    Visibility="{Binding IsImagePopupEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">

                                                    <ToolTip.Template>
                                                        <ControlTemplate>
                                                            <Border
                                                                Background="Black"
                                                                BorderBrush="Black"
                                                                BorderThickness="1">
                                                                <Image
                                                                    Width="320"
                                                                    Height="180"
                                                                    Source="{Binding ThumbnailImageSource}" />
                                                            </Border>
                                                        </ControlTemplate>
                                                    </ToolTip.Template>
                                                </ToolTip>
                                            </Image.ToolTip>
                                        </Image>

                                        <!--  Media type badge  -->
                                        <Border
                                            Width="22"
                                            Height="22"
                                            Margin="4"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Background="{StaticResource OnlyMMediaTypeBadgeFill}"
                                            BorderBrush="{StaticResource OnlyMMediaTypeBadgeStroke}"
                                            BorderThickness="1"
                                            CornerRadius="4">
                                            <materialDesign:PackIcon
                                                Width="16"
                                                Height="16"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Foreground="{Binding IconBrush}"
                                                Kind="{Binding IconName}" />
                                        </Border>

                                        <Border
                                            BorderBrush="Black"
                                            BorderThickness="1"
                                            ToolTip="{x:Static resx:Resources.WILL_PAUSE}"
                                            Visibility="{Binding PauseOnLastFrame, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Image
                                                Width="12"
                                                HorizontalAlignment="Right"
                                                Opacity="0.9"
                                                Source="../Images/freeze2.png"
                                                Stretch="Fill" />
                                        </Border>

                                    </Grid>
                                </Border>
                                <!--  End of Thumbnail  -->

                                <!--  Main section of Card  -->
                                <Grid Grid.Column="2" Margin="10,0,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="34" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!--  Media Title  -->
                                    <StackPanel Grid.Row="0">
                                        <TextBlock
                                            FontSize="15"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource MaterialDesignBody}"
                                            Text="{Binding Title, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{DynamicResource MaterialDesignBodyLight}"
                                            Text="{Binding FileNameAsSubTitle, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Grid Grid.Row="1">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="1*" />
                                            <RowDefinition Height="1*" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="95" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!--  TextBlocks generally used to show media length and duration  -->

                                        <TextBlock
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Foreground="{Binding DurationColorBrush}"
                                            Style="{StaticResource OnlyMTimeText}"
                                            Text="{Binding DurationString}"
                                            Visibility="{Binding Path=HasDuration, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                        <StackPanel
                                            Grid.Row="1"
                                            Grid.Column="0"
                                            Orientation="Horizontal">

                                            <TextBlock
                                                Foreground="{Binding PlaybackTimeColorBrush}"
                                                Style="{StaticResource OnlyMTimeText}"
                                                Text="{Binding PlaybackTimeString}"
                                                Visibility="{Binding Path=HasDuration, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                            <Button
                                                Width="22"
                                                Height="17"
                                                Margin="6,0,0,0"
                                                Padding="0"
                                                VerticalAlignment="Center"
                                                Command="{Binding Path=DataContext.EnterStartOffsetEditModeCommand, ElementName=OnlyMOperatorPage}"
                                                CommandParameter="{Binding Id}"
                                                IsEnabled="{Binding IsStartOffsetButtonEnabled}"
                                                Style="{StaticResource MaterialDesignIconButton}"
                                                ToolTip="{x:Static resx:Resources.SHOW_START_OFFSET_DLG}"
                                                Visibility="{Binding Path=IsStartOffsetButtonVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <materialDesign:PackIcon
                                                    Width="16"
                                                    Height="16"
                                                    Kind="DotsHorizontal" />
                                            </Button>

                                        </StackPanel>

                                        <!--  Pause button  -->
                                        <Button
                                            Grid.Row="0"
                                            Grid.RowSpan="2"
                                            Grid.Column="1"
                                            Width="40"
                                            Height="Auto"
                                            Margin="5,0,0,0"
                                            Padding="0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Stretch"
                                            Command="{Binding Path=DataContext.MediaControlPauseCommand, ElementName=OnlyMOperatorPage}"
                                            CommandParameter="{Binding Id}"
                                            Style="{StaticResource OnlyMSubtleButton}"
                                            Visibility="{Binding Path=IsPauseButtonVisible, Converter={StaticResource BooleanToVisibilityConverter}}">

                                            <materialDesign:PackIcon
                                                Width="20"
                                                Height="20"
                                                HorizontalAlignment="Center"
                                                Kind="{Binding PauseIconKind}" />
                                        </Button>

                                        <!--  Web and PDF Mirror button  -->
                                        <CheckBox
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Grid.ColumnSpan="2"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Checked="MirrorCheckBoxChecked"
                                            Content="{x:Static resx:Resources.MIRROR}"
                                            FontSize="13"
                                            IsChecked="{Binding UseMirror, Mode=TwoWay}"
                                            Style="{StaticResource MaterialDesignCheckBox}"
                                            Tag="{Binding Id}"
                                            Unchecked="MirrorCheckBoxUnchecked"
                                            Visibility="{Binding Path=IsWebAndAllowMirror, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                        <!--  Slide Navigation buttons  -->
                                        <StackPanel
                                            Grid.Row="0"
                                            Grid.RowSpan="2"
                                            Grid.Column="0"
                                            Grid.ColumnSpan="2"
                                            Orientation="Horizontal">
                                            <Button
                                                Command="{Binding Path=DataContext.PreviousSlideCommand, ElementName=OnlyMOperatorPage}"
                                                CommandParameter="{Binding Id}"
                                                IsEnabled="{Binding IsPreviousSlideButtonEnabled}"
                                                Style="{StaticResource SlideshowButtonStyle}"
                                                Visibility="{Binding Path=IsSlideshow, Converter={StaticResource BooleanToVisibilityConverter}}">

                                                <materialDesign:PackIcon
                                                    Width="20"
                                                    Height="20"
                                                    Kind="StepBackward" />

                                            </Button>
                                            <Button
                                                Margin="6,0,0,0"
                                                Command="{Binding Path=DataContext.NextSlideCommand, ElementName=OnlyMOperatorPage}"
                                                CommandParameter="{Binding Id}"
                                                IsEnabled="{Binding IsNextSlideButtonEnabled}"
                                                Style="{StaticResource SlideshowButtonStyle}"
                                                Visibility="{Binding Path=IsSlideshow, Converter={StaticResource BooleanToVisibilityConverter}}">

                                                <materialDesign:PackIcon
                                                    Width="20"
                                                    Height="20"
                                                    Kind="StepForward" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                    <controls:PathTextBlock
                                        Grid.Row="2"
                                        Grid.ColumnSpan="2"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{DynamicResource MaterialDesignBodyLight}"
                                        Path="{Binding MiscText}" />

                                    <!--  Progress bar and Slider  -->
                                    <ProgressBar
                                        Grid.Row="2"
                                        Height="3"
                                        Margin="0,2,0,0"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource MaterialDesignDivider}"
                                        BorderThickness="0"
                                        Maximum="{Binding DurationDeciseconds}"
                                        Visibility="{Binding Path=HasDurationAndIsPlaying, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Value="{Binding PlaybackPositionDeciseconds, Mode=OneWay}" />
                                    <Slider
                                        Grid.Row="2"
                                        Margin="0,8,0,0"
                                        LargeChange="300"
                                        Maximum="{Binding DurationDeciseconds}"
                                        Orientation="Horizontal"
                                        SmallChange="10"
                                        TickFrequency="1"
                                        Visibility="{Binding Path=IsSliderVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Value="{Binding PlaybackPositionDeciseconds, Mode=TwoWay}">
                                        <Slider.LayoutTransform>
                                            <ScaleTransform ScaleX="0.5" ScaleY="0.5" />
                                        </Slider.LayoutTransform>
                                    </Slider>
                                    <TextBlock
                                        Grid.Row="2"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{DynamicResource MaterialDesignBodyLight}"
                                        Text="{Binding SlideshowProgressString}"
                                        Visibility="{Binding Path=IsSlideshow, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </Grid>

                                <!--  Spinner as media is being prepared  -->
                                <ProgressBar
                                    Grid.Column="3"
                                    IsIndeterminate="True"
                                    Style="{StaticResource MaterialDesignCircularProgressBar}"
                                    Visibility="{Binding Path=IsPreparingMedia, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Value="0" />

                                <!--  Start and Stop buttons  -->
                                <Button
                                    Grid.Column="3"
                                    Command="{Binding Path=DataContext.MediaControlCommand1, ElementName=OnlyMOperatorPage}"
                                    CommandParameter="{Binding Id}"
                                    IsEnabled="{Binding IsPlayButtonEnabled}"
                                    Style="{StaticResource OnlyMPlayButton}"
                                    Visibility="{Binding Path=IsPlayButtonVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <materialDesign:PackIcon
                                        Width="24"
                                        Height="24"
                                        Kind="Play" />
                                </Button>

                                <Button
                                    Grid.Column="3"
                                    Command="{Binding Path=DataContext.MediaControlCommand1, ElementName=OnlyMOperatorPage}"
                                    CommandParameter="{Binding Id}"
                                    Style="{StaticResource OnlyMStopButton}"
                                    Visibility="{Binding Path=IsStopButtonVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <materialDesign:PackIcon
                                        Width="22"
                                        Height="22"
                                        Kind="Stop" />
                                </Button>
                            </Grid>
                            <!--  End of Media Card Body  -->

                        </materialDesign:DrawerHost>
                    </Border>
                </materialDesign:Card>
                <!--  End of Media Item Card  -->

            </DataTemplate>

        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="UserControl.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation
                        Storyboard.TargetProperty="Opacity"
                        From="0.0"
                        To="1.0"
                        Duration="0:0:1" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Row="0"
            HorizontalAlignment="Left"
            Orientation="Horizontal">

            <!--  Media list menu (optional, see Settings): actions that apply to the whole media list / folder  -->
            <Menu
                Margin="4,6,0,2"
                VerticalAlignment="Center"
                Background="Transparent"
                Visibility="{Binding ShowMediaListMenu, Converter={StaticResource BooleanToVisibilityConverter}}">
                <MenuItem
                    x:Name="MediaListMenuItem"
                    Height="32"
                    Padding="6,0"
                    AutomationProperties.Name="{x:Static resx:Resources.MEDIA_LIST_MENU}"
                    SubmenuOpened="MediaListMenuItem_SubmenuOpened"
                    ToolTip="{x:Static resx:Resources.MEDIA_LIST_MENU}">
                    <MenuItem.Header>
                        <materialDesign:PackIcon
                            Width="24"
                            Height="24"
                            Kind="DotsVertical" />
                    </MenuItem.Header>

                    <MenuItem Command="{Binding AddFilesCommand}" Header="{x:Static resx:Resources.MENU_ADD_FILES}">
                        <MenuItem.Icon>
                            <materialDesign:PackIcon Kind="FilePlusOutline" />
                        </MenuItem.Icon>
                    </MenuItem>

                    <MenuItem Command="{Binding RefreshCommand}" Header="{x:Static resx:Resources.MENU_REFRESH}">
                        <MenuItem.Icon>
                            <materialDesign:PackIcon Kind="Refresh" />
                        </MenuItem.Icon>
                    </MenuItem>

                    <Separator />

                    <MenuItem
                        Header="{x:Static resx:Resources.MENU_RECENT_FOLDERS}"
                        ItemsSource="{Binding RecentMediaFolders}"
                        Visibility="{Binding ShowRecentFolders, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <MenuItem.Icon>
                            <materialDesign:PackIcon Kind="FolderClockOutline" />
                        </MenuItem.Icon>
                        <MenuItem.ItemContainerStyle>
                            <Style BasedOn="{StaticResource MaterialDesignMenuItem}" TargetType="MenuItem">
                                <!--  The tick is drawn in the header: the Material Design menu item doesn't show IsChecked for non-checkable items  -->
                                <Setter Property="Header" Value="{Binding}" />
                                <Setter Property="HeaderTemplate">
                                    <Setter.Value>
                                        <DataTemplate DataType="{x:Type models:RecentFolderMenuItem}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon
                                                    x:Name="CurrentFolderTick"
                                                    Width="16"
                                                    Height="16"
                                                    Margin="0,0,8,0"
                                                    VerticalAlignment="Center"
                                                    Kind="Check"
                                                    Visibility="Hidden" />
                                                <TextBlock VerticalAlignment="Center" Text="{Binding Path}" />
                                            </StackPanel>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                    <Setter TargetName="CurrentFolderTick" Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="AutomationProperties.Name" Value="{Binding Path}" />
                                <Setter Property="Command" Value="{Binding Command}" />
                                <Setter Property="CommandParameter" Value="{Binding Path}" />
                            </Style>
                        </MenuItem.ItemContainerStyle>
                    </MenuItem>

                    <MenuItem Command="{Binding OpenMediaFolderCommand}" Header="{x:Static resx:Resources.MENU_OPEN_FOLDER}">
                        <MenuItem.Icon>
                            <materialDesign:PackIcon Kind="FolderOpenOutline" />
                        </MenuItem.Icon>
                    </MenuItem>

                    <Separator />

                    <MenuItem Command="{Binding HideAllCommand}" Header="{x:Static resx:Resources.MENU_HIDE_ALL}">
                        <MenuItem.Icon>
                            <materialDesign:PackIcon Kind="EyeOffOutline" />
                        </MenuItem.Icon>
                    </MenuItem>

                    <MenuItem Command="{Binding UnhideAllCommand}" Header="{x:Static resx:Resources.MENU_UNHIDE_ALL}">
                        <MenuItem.Icon>
                            <materialDesign:PackIcon Kind="EyeOutline" />
                        </MenuItem.Icon>
                    </MenuItem>

                    <Separator />

                    <MenuItem Command="{Binding DeleteHiddenCommand}" Header="{x:Static resx:Resources.MENU_DELETE_HIDDEN}">
                        <MenuItem.Icon>
                            <materialDesign:PackIcon Kind="DeleteSweepOutline" />
                        </MenuItem.Icon>
                    </MenuItem>

                    <MenuItem Command="{Binding DeleteAllCommand}" Header="{x:Static resx:Resources.MENU_DELETE_ALL}">
                        <MenuItem.Icon>
                            <materialDesign:PackIcon Kind="DeleteForeverOutline" />
                        </MenuItem.Icon>
                    </MenuItem>
                </MenuItem>
            </Menu>

            <ToggleButton
                Width="32"
                Height="32"
                Margin="8,6,0,2"
                AutomationProperties.Name="{x:Static resx:Resources.SORT_MODE}"
                IsChecked="{Binding IsManualSortMode, Mode=TwoWay}"
                Visibility="{Binding ShowSortModeToggleButton, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ToggleButton.Style>
                    <!--  Neutral in automatic sort mode; purple only while manual (drag) sorting is on  -->
                    <Style BasedOn="{StaticResource MaterialDesignActionToggleButton}" TargetType="ToggleButton">
                        <Setter Property="ToolTip" Value="{x:Static resx:Resources.SORT_MODE_AUTO_TOOLTIP}" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
                        <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp0" />
                        <Style.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="ToolTip" Value="{x:Static resx:Resources.SORT_MODE_MANUAL_TOOLTIP}" />
                                <Setter Property="Background" Value="{DynamicResource PrimaryHueMidBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryHueMidForegroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource MaterialDesignDivider}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsChecked" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter Property="Background" Value="{DynamicResource PrimaryHueDarkBrush}" />
                            </MultiTrigger>
                        </Style.Triggers>
                    </Style>
                </ToggleButton.Style>
                <ToggleButton.Content>
                    <materialDesign:PackIcon
                        Width="24"
                        Height="24"
                        Kind="SortAlphabeticalAscending" />
                </ToggleButton.Content>
                <materialDesign:ToggleButtonAssist.OnContent>
                    <materialDesign:PackIcon
                        Width="24"
                        Height="24"
                        Kind="Drag" />
                </materialDesign:ToggleButtonAssist.OnContent>
            </ToggleButton>
        </StackPanel>

        <!--  Media item count badge - shown once the list is non-empty; highlighted when the configured maximum is reached  -->
        <!--  Right margin (16) = scrollbar width (12, see MainWindow's ScrollBar style) + card margin (4) so the badge's right edge lines up with the cards' right edge  -->
        <Border
            Grid.Row="0"
            Margin="0,6,16,2"
            Padding="8,1"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Background="{DynamicResource MaterialDesignDivider}"
            CornerRadius="8"
            Visibility="{Binding Path=IsMediaItemCountVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsMediaItemCountAtMax}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource PrimaryHueMidBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock
                FontSize="11"
                Foreground="{DynamicResource MaterialDesignBody}"
                Text="{Binding MediaItemCountText}"
                ToolTip="{x:Static resx:Resources.MAX_ITEMS}" />
        </Border>

        <ListBox
            x:Name="OperatorMediaList"
            Grid.Row="1"
            AllowDrop="True"
            Background="Transparent"
            BorderThickness="0"
            Drop="OperatorMediaList_Drop"
            ItemsSource="{Binding MediaItems}"
            PreviewDragEnter="OperatorMediaList_DragOver"
            PreviewDragLeave="OperatorMediaList_DragLeave"
            PreviewDragOver="OperatorMediaList_DragOver"
            PreviewMouseLeftButtonDown="OperatorMediaList_PreviewMouseLeftButtonDown"
            PreviewMouseMove="OperatorMediaList_PreviewMouseMove"
            ScrollViewer.VerticalScrollBarVisibility="Visible"
            VirtualizingPanel.ScrollUnit="Pixel"
            VirtualizingPanel.VirtualizationMode="Recycling">
            <ListBox.ItemContainerStyle>
                <Style TargetType="{x:Type ListBoxItem}">
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                <!--
                                    Background="Transparent" makes the whole item hit-testable, including the
                                    margin around the card content - without it, that margin band is invisible to hit
                                    testing (nothing is painted there), so the pointer briefly "misses" the item during
                                    a drag whenever it lands in that band, flickering the insertion line and cursor.
                                -->
                                <Border Background="Transparent">
                                    <ContentPresenter />
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>
    </Grid>

</UserControl>
